        "id": "65aa26e1149ac6ad",
        "type": "function",
        "z": "a620ec8a5ec05a43",
        "name": "SortByDate",
        "func": "const readings = msg.payload || [];\n\nreadings.sort(function(a, b) {\n    return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();\n});\n\nreturn msg;",
